            "id": "SetConfig",
            "name": "Set Config",
            "type": "n8n-nodes-base.set",
            "typeVersion": 2,
            "position": [
                480,
                240
            ]
        },
        {
            "parameters": {
                "jsCode": "const pad = (n) => String(n).padStart(4,'0');\nconst now = new Date();\nconst stamp = now.toISOString().replace(/[:.]/g,'-');\n// Simple counter based on timestamp (works fine for V1)\nconst epSlug = `ep_${stamp}`;\n\nconst base = $json.BASE_DIR;\nconst epDir = `${base}\\\\${epSlug}`;\n\nreturn [{\n  ...$json,\n  EP_SLUG: epSlug,\n  EP_DIR: epDir,\n  DIR_AUDIO: `${epDir}\\\\audio`,\n  DIR_VIDEO: `${epDir}\\\\video`,\n  DIR_OUT: `${epDir}\\\\out`,\n  DIR_TMP: `${epDir}\\\\tmp`,\n  CONCAT_LIST: `${epDir}\\\\tmp\\\\concat.txt`,\n  SCRIPT_TXT: `${epDir}\\\\tmp\\\\script.txt`,\n  SCENES_JSON: `${epDir}\\\\tmp\\\\scenes.json`,\n  FINAL_NO_MUSIC: `${epDir}\\\\out\\\\final_no_music.mp4`,\n  FINAL_MP4: `${epDir}\\\\out\\\\final.mp4`\n}];"
            },
            "id": "BuildPaths",
            "name": "Build Paths",
            "type": "n8n-nodes-base.function",
            "typeVersion": 2,
            "position": [
                720,
                240
            ]
        },
        {
            "parameters": {
                "command": "powershell",
                "parameters": "-NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force -Path '{{$json.EP_DIR}}','{{$json.DIR_AUDIO}}','{{$json.DIR_VIDEO}}','{{$json.DIR_OUT}}','{{$json.DIR_TMP}}' | Out-Null\""
            },
            "id": "MkDirs",
            "name": "Create Episode Folders",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                960,
                240
            ]
        },
        {
            "parameters": {
                "jsCode": "const BIBLE = `\nSérie enfants francophone : Lina & Jannah\n- Lina : 8 ans, brune, yeux marron, curieuse, courageuse, parle en premier.\n- Jannah : 7 ans, blonde, yeux bleus, réfléchie, sensible, très observatrice.\nUnivers : monde réel + magie douce. Ton rassurant, mystérieux léger.\nRègles : pas de violence, pas de peur intense. Morale implicite. Cliffhanger doux.\n`;\n\nconst STRUCTURE = `\nStructure obligatoire (≈2 minutes max) :\n1) Hook intrigant (10–15s)\n2) Mise en place\n3) Découverte mystérieuse/magique\n4) Tension douce (question/doute)\n5) Action/choix\n6) Cliffhanger parlé\nNarrateur 60–70%, dialogues 30–40%. Lina parle en premier.\n`;\n\nreturn [{\n  ...$json,\n  BIBLE,\n  STRUCTURE\n}];"
            },
            "id": "BibleAndStructure",
            "name": "Bible + Structure",
            "type": "n8n-nodes-base.function",
            "typeVersion": 2,
            "position": [
                1200,
                240
            ]
        },
        {
            "parameters": {
                "jsCode": "const ideaPrompt = `Tu es le showrunner de la série pour enfants "Lina & Jannah".\\n\\nBible:\\n${$json.BIBLE}\\n\\nPropose 1 idée d'épisode captivante (public 6–10 ans, français simple).\\n- Univers magique doux\\n- Mystère ou découverte\\n- Fin: cliffhanger léger\\n\\nDonne uniquement:\\n- Titre\\n- Résumé en 4 phrases max`;\n\nconst writerPrompt = `Tu es un auteur d'histoires pour enfants.\\n\\nÉcris une histoire CAPTIVANTE de 2 minutes maximum mettant en scène Lina et Jannah.\\n\\nContraintes:\\n- Français simple (6–10 ans)\\n- Narrateur + dialogues\\n- Narrateur 60–70%\\n- Dialogues 30–40%\\n- Pas de violence, pas de peur intense\\n\\n${$json.STRUCTURE}\\n\\nBible:\\n${$json.BIBLE}\\n\\nImportant :\\n- Lina parle en premier\\n- Dialogues courts et naturels\\n- Termine par un cliffhanger parlé\\n\\nÉcris le texte complet prêt pour voix off. Aucun commentaire technique.`;\n\nconst scenesPrompt = `À partir de l'histoire suivante:\\n\\n\"\"\"\\n{{SCRIPT}}\\n\"\"\"\\n\\nDécoupe en 8 à 10 scènes. Retourne UNIQUEMENT un JSON strict :\\n[\\n  {\\n    \\\"scene\\\": 1,\\n    \\\"duration\\\": 12,\\n    \\\"decor\\\": \\\"...\\\",\\n    \\\"narration\\\": \\\"...\\\",\\n    \\\"dialogues\\\": [\\n      { \\\"character\\\": \\\"Lina\\\", \\\"text\\\": \\\"...\\\" },\\n      { \\\"character\\\": \\\"Jannah\\\", \\\"text\\\": \\\"...\\\" }\\n    ],\\n    \\\"ambiance\\\": \\\"magique / calme / mystérieuse\\\"\\n  }\\n]\\n\\nContraintes: durée totale ≈120s, cliffhanger en dernière scène.`;\n\nreturn [{...$json, ideaPrompt, writerPrompt, scenesPrompt}];"
            },
            "id": "BuildPrompts",
            "name": "Build Prompts",
            "type": "n8n-nodes-base.function",
            "typeVersion": 2,
            "position": [
                1440,
                240
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$json.LLM_ENDPOINT}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "={{'Bearer ' + $json.LLM_API_KEY}}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"mode\": \"showrunner\",\n  \"prompt\": $json.ideaPrompt\n}",
                "options": {
                    "timeout": 180000
                }
            },
            "id": "LLMShowrunner",
            "name": "LLM - Showrunner Idea (HTTP)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1680,
                120
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$json.LLM_ENDPOINT}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "={{'Bearer ' + $json.LLM_API_KEY}}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"mode\": \"writer\",\n  \"prompt\": $json.writerPrompt\n}",
                "options": {
                    "timeout": 180000
                }
            },
            "id": "LLMWriter",
            "name": "LLM - Writer Script (HTTP)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1680,
                240
            ]
        },
        {
            "parameters": {
                "jsCode": "// Expect the LLM endpoint to return JSON like: {\"text\":\"...\"}\n// If your endpoint returns something else, adapt here.\nconst script = $json.text || $json.data?.text || $json.choices?.[0]?.message?.content || $json.output || '';\nif (!script || script.length < 50) {\n  throw new Error('LLM script empty. Adjust parsing in Normalize Script node.');\n}\nreturn [{...$json, SCRIPT: script}];"
            },
            "id": "NormalizeScript",
            "name": "Normalize Script",
            "type": "n8n-nodes-base.function",
            "typeVersion": 2,
            "position": [
                1920,
                240
            ]
        },
        {
            "parameters": {
                "command": "powershell",
                "parameters": "-NoProfile -ExecutionPolicy Bypass -Command \"Set-Content -Path '{{$json.SCRIPT_TXT}}' -Value @'\n{{$json.SCRIPT}}\n'@ -Encoding UTF8\""
            },
            "id": "WriteScriptFile",
            "name": "Write script.txt",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                2160,
                240
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$json.LLM_ENDPOINT}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "={{'Bearer ' + $json.LLM_API_KEY}}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"mode\": \"scenes\",\n  \"prompt\": $json.scenesPrompt.replace('{{SCRIPT}}', $json.SCRIPT)\n}",
                "options": {
                    "timeout": 180000
                }
            },
            "id": "LLMScenes",
            "name": "LLM - Scenes JSON (HTTP)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1680,
                360
            ]
        },
        {
            "parameters": {
                "jsCode": "let raw = $json.text || $json.data?.text || $json.choices?.[0]?.message?.content || $json.output || '';\nif (!raw) throw new Error('LLM scenes empty.');\nraw = raw.trim();\n// If the model wraps JSON in markdown, strip it.\nraw = raw.replace(/^```json\\s*/i,'').replace(/^```\\s*/,'').replace(/```\\s*$/,'');\n\nlet scenes;\ntry { scenes = JSON.parse(raw); } catch (e) {\n  throw new Error('Scenes JSON parse failed. Fix LLM output / parsing.');\n}\nif (!Array.isArray(scenes) || scenes.length < 6) {\n  throw new Error('Scenes array invalid / too short.');\n}\nconst total = scenes.reduce((a,s)=>a + (Number(s.duration)||0),0);\nif (total < 90 || total > 150) {\n  // V1 tolerance\n  // Not fatal, but warn by storing.\n}\nreturn [{...$json, SCENES: scenes, SCENES_TOTAL: total}];"
            },
            "id": "ParseScenes",
            "name": "Parse Scenes JSON",
            "type": "n8n-nodes-base.function",
            "typeVersion": 2,
            "position": [
                1920,
                360
            ]
        },
        {
            "parameters": {
                "command": "powershell",
                "parameters": "-NoProfile -ExecutionPolicy Bypass -Command \"$j = @'\n{{JSON}}\n'@; $j = $j -replace '{{JSON}}', (ConvertTo-Json -Depth 10 -Compress ({{$json.SCENES}})); Set-Content -Path '{{$json.SCENES_JSON}}' -Value $j -Encoding UTF8\""
            },
            "id": "WriteScenesFile",
            "name": "Write scenes.json",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                2160,
                360
            ]
        },
        {
            "parameters": {
                "functionCode": "const scenes = $json.SCENES;\nreturn scenes.map((s, i) => ({\n  ...$json,\n  sceneItem: {\n    scene: s.scene ?? (i+1),\n    idx: i+1,\n    duration: Number(s.duration) || 12,\n    decor: s.decor || 'Décor doux',\n    ambiance: s.ambiance || 'magique',\n    narration: s.narration || '',\n    dialogues: Array.isArray(s.dialogues) ? s.dialogues : []\n  }\n}));"
            },
            "id": "ExplodeScenes",
            "name": "Explode Scenes (items)",
            "type": "n8n-nodes-base.function",
            "typeVersion": 2,
            "position": [
                2400,
                360
            ]
        },
        {
            "parameters": {
                "batchSize": 1,
                "options": {}
            },
            "id": "SplitInBatches",
            "name": "Split in Batches (per scene)",
            "type": "n8n-nodes-base.splitInBatches",
            "typeVersion": 3,
            "position": [
                2640,
                360
            ]
        },
        {
            "parameters": {
                "jsCode": "const s = $json.sceneItem;\nconst pad2 = (n) => String(n).padStart(2,'0');\nconst idx = pad2(s.idx);\n\n// Build per-scene SSML: narrator + Lina + Jannah (short)\n// We keep it simple and safe for Azure.\nconst narrator = ($json.VOICE_NARRATOR || 'fr-FR-DeniseNeural');\nconst lina = ($json.VOICE_LINA || 'fr-FR-EloiseNeural');\nconst jannah = ($json.VOICE_JANNAH || 'fr-FR-CharlineNeural');\n\nconst esc = (t) => (t || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\nlet ssml = `<?xml version=\"1.0\" encoding=\"utf-8\"?>\\n<speak version=\"1.0\" xml:lang=\"fr-FR\" xmlns=\"http://www.w3.org/2001/10/synthesis\" xmlns:mstts=\"http://www.w3.org/2001/mstts\">`;\n\nif (s.narration) {\n  ssml += `\\n<voice name=\"${narrator}\"><mstts:express-as style=\"calm\">${esc(s.narration)}</mstts:express-as></voice>`;\n}\n\nfor (const d of (s.dialogues || [])) {\n  const who = (d.character || '').toLowerCase();\n  const voice = who.includes('lina') ? lina : (who.includes('jannah') ? jannah : narrator);\n  ssml += `\\n<break time=\"200ms\"/><voice name=\"${voice}\">${esc(d.text)}</voice>`;\n}\n\nssml += `\\n</speak>`;\n\nreturn [{\n  ...$json,\n  SSML: ssml,\n  SCENE_IDX: s.idx,\n  SCENE_DUR: s.duration,\n  SCENE_VIDEO: `${$json.DIR_VIDEO}\\\\scene_${idx}.mp4`,\n  SCENE_AUDIO: `${$json.DIR_AUDIO}\\\\scene_${idx}.wav`,\n  SCENE_AUDIO_MIX: `${$json.DIR_AUDIO}\\\\scene_${idx}_mix.wav`\n}];"
            },
            "id": "BuildSSML",
            "name": "Build SSML + Filenames",
            "type": "n8n-nodes-base.function",
            "typeVersion": 2,
            "position": [
                2880,
                360
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{'https://' + $json.AZURE_SPEECH_REGION + '.tts.speech.microsoft.com/cognitiveservices/v1'}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Ocp-Apim-Subscription-Key",
                            "value": "={{$json.AZURE_SPEECH_KEY}}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/ssml+xml"
                        },
                        {
                            "name": "X-Microsoft-OutputFormat",
                            "value": "riff-24khz-16bit-mono-pcm"
                        },
                        {
                            "name": "User-Agent",
                            "value": "n8n-lina-jannah"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "string",
                "body": "={{$json.SSML}}",
                "options": {
                    "timeout": 180000
                },
                "responseFormat": "file",
                "dataPropertyName": "audio"
            },
            "id": "AzureTTS",
            "name": "Azure TTS (WAV)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                3120,
                360
            ]
        },
        {
            "parameters": {
                "fileName": "={{$json.SCENE_AUDIO}}",
                "dataPropertyName": "audio"
            },
            "id": "WriteAudio",
            "name": "Write scene WAV",
            "type": "n8n-nodes-base.writeBinaryFile",
            "typeVersion": 1,
            "position": [
                3360,
                360
            ]
        },
        {
            "parameters": {
                "command": "powershell",
                "parameters": "-NoProfile -ExecutionPolicy Bypass -Command \"ffmpeg -y -i '{{$json.SCENE_AUDIO}}' -i '{{$json.SFX_MAGIC}}' -filter_complex \\\"[1:a]volume=0.30[a1];[0:a][a1]amix=inputs=2:duration=first:dropout_transition=2\\\" '{{$json.SCENE_AUDIO_MIX}}'\""
            },
            "id": "MixSFX",
            "name": "Mix SFX (simple)",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                3600,
                360
            ]
        },
        {
            "parameters": {
                "command": "powershell",
                "parameters": "-NoProfile -ExecutionPolicy Bypass -Command \"ffmpeg -y -loop 1 -i '{{$json.DEFAULT_BG_IMAGE}}' -i '{{$json.SCENE_AUDIO_MIX}}' -vf \\\"scale={{$json.WIDTH}}:{{$json.HEIGHT}},format=yuv420p,zoompan=z='min(zoom+0.0008,1.08)':d={{$json.FPS}}*{{$json.SCENE_DUR}}:s={{$json.WIDTH}}x{{$json.HEIGHT}}\\\" -t {{$json.SCENE_DUR}} -r {{$json.FPS}} -c:v {{$json.ENCODER}} -b:v {{$json.BITRATE}} -c:a aac -shortest '{{$json.SCENE_VIDEO}}'\""
            },
            "id": "MakeSceneVideo",
            "name": "Make scene video (image+audio)",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                3840,
                360
            ]
        },
        {
            "parameters": {},
            "id": "NextBatch",
            "name": "Next batch",
            "type": "n8n-nodes-base.noOp",
            "typeVersion": 1,
            "position": [
                4080,
                360
            ]
        },
        {
            "parameters": {
                "jsCode": "return [{...$json}];"
            },
            "id": "AfterScenes",
            "name": "After all scenes",
            "type": "n8n-nodes-base.function",
            "typeVersion": 2,
            "position": [
                2640,
                560
            ]
        },
        {
            "parameters": {
                "command": "powershell",
                "parameters": "-NoProfile -ExecutionPolicy Bypass -Command \"Get-ChildItem -Path '{{$json.DIR_VIDEO}}' -Filter 'scene_*.mp4' | Sort-Object Name | ForEach-Object { 'file ''{0}''' -f $_.FullName } | Set-Content -Path '{{$json.CONCAT_LIST}}' -Encoding ASCII\""
            },
            "id": "BuildConcatList",
            "name": "Build concat.txt",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                2880,
                560
            ]
        },
        {
            "parameters": {
                "command": "powershell",
                "parameters": "-NoProfile -ExecutionPolicy Bypass -Command \"ffmpeg -y -f concat -safe 0 -i '{{$json.CONCAT_LIST}}' -c copy '{{$json.FINAL_NO_MUSIC}}'\""
            },
            "id": "ConcatScenes",
            "name": "Concat scenes",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                3120,
                560
            ]
        },
        {
            "parameters": {
                "command": "powershell",
                "parameters": "-NoProfile -ExecutionPolicy Bypass -Command \"ffmpeg -y -i '{{$json.FINAL_NO_MUSIC}}' -i '{{$json.MUSIC_BED}}' -filter_complex \\\"[1:a]volume=0.10[a1];[0:a][a1]amix=inputs=2:duration=first:dropout_transition=2\\\" -c:v copy -c:a aac '{{$json.FINAL_MP4}}'\""
            },
            "id": "AddMusic",
            "name": "Add background music",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                3360,
                560
            ]
        },
        {
            "parameters": {
                "jsCode": "const msg = `✅ Épisode prêt :\\n- Dossier: ${$json.EP_DIR}\\n- Fichier final: ${$json.FINAL_MP4}\\n\\nAstuce encodage: si h264_qsv échoue, mets ENCODER = h264_nvenc ou libx264 dans Set Config.`;\nreturn [{...$json, RESULT: msg}];"
            },
            "id": "DoneMessage",
            "name": "Done message",
            "type": "n8n-nodes-base.function",
            "typeVersion": 2,
            "position": [
                3600,
                560
            ]
        }
    ],
